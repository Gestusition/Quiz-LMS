# Copy this file to .env only on your own machine. Never commit real credentials.
AI_QUIZ_ENABLED=true
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_CHAT_DEPLOYMENT=your_chat_deployment_name_here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your_embedding_deployment_name_here
AZURE_OPENAI_API_VERSION=your_api_version_here

# Optional: a long random local value used to encrypt credentials entered in the UI.
# When omitted, the server creates data/.ai-credentials.key (data/ is gitignored).
AI_CREDENTIALS_ENCRYPTION_KEY=your_local_encryption_secret_here
