    "test:api-docs": "jest tests/swaggerCoverage.test.js --runInBand --forceExit",
    "coverage": "jest --coverage --runInBand --forceExit"
  },
  "keywords": [
    "quiz",
    "lms",
    "education",
    "crud",
    "rest-api",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "overrides": {
    "glob": "^13.0.6",
    "swagger-parser": {
      "@apidevtools/swagger-parser": "^12.1.0"
    }
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
