{
  "name": "quiz-lms",
  "version": "1.1.0+3",
  "description": "A role-based quiz LMS with secure accounts, course management, quiz attempts, REST API, and vanilla JavaScript SPA.",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prestart": "npm run build:ai",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:ai": "vite build --watch --config frontend/ai-assistant/vite.config.ts",
    "build:ai": "vite build --config frontend/ai-assistant/vite.config.ts",
    "typecheck:ai": "tsc --noEmit -p frontend/ai-assistant/tsconfig.json",
    "test:ai": "vitest run --config frontend/ai-assistant/vitest.config.ts",
    "verify:ai": "npm run typecheck:ai && npm run test:ai && npm run build:ai",
    "test": "jest tests --verbose --runInBand --forceExit",
    "test:api-docs": "jest tests/swaggerCoverage.test.js --runInBand --forceExit",
    "coverage": "jest tests --coverage --runInBand --forceExit"
  },
  "keywords": [
    "quiz",
    "lms",
    "education",
    "crud",
    "rest-api",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "glob": "^13.0.6",
    "swagger-parser": {
      "@apidevtools/swagger-parser": "^12.1.0"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
